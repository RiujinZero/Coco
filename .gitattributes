# Keep LF in the working copy on every platform. Scripts run under bash in WSL (CRLF breaks them), sources are
# compiled by g++ in WSL and by MSVC (both accept LF); this overrides a machine's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary content
*.png binary
*.jpg binary
*.pdf binary
*.bin binary
*.state binary
*.zip binary
*.docx binary
